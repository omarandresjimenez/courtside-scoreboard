# Copy this file to .env and fill in real values. .env is gitignored.

# SQLite is a single file — no external database service to install.
DATABASE_URL="file:./dev.db"

PORT=3000

# Single shared password protecting the admin app (Set 08 — QR, links & security).
ADMIN_PASSWORD="change-me"

# ========== Cloud Streaming (Optional - leave blank to skip) ==========
# Firebase Admin SDK credentials - get from Firebase Console
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY="-"
FIREBASE_CLIENT_EMAIL= ""
FIREBASE_CLIENT_ID= ""

# Cloudinary CDN for video frame storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloud API URL (for local development, leave as-is)
CLOUD_API_URL=http://localhost:3001

CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
