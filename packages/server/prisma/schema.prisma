// Prisma schema — mirrors "Set 06 — Data model" of the design spec.
// SQLite: a single embedded file, no external database service to run
// on-site (see "Set 02 — Architecture").

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  // "native" alone only ships the engine for whichever machine ran
  // `prisma generate` — fine for the plain LAN server, but the desktop
  // app (packages/desktop) bundles this generated client into installers
  // built on one machine and run on another OS/CPU, so every platform it
  // targets needs its engine binary generated here too.
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Court {
  id             String   @id @default(cuid())
  tournamentId   String?
  tournament     Tournament? @relation(fields: [tournamentId], references: [id])
  label          String
  /// The live pointer a TV screen follows; null while idle. Not a formal
  /// relation on purpose — assigning a match is a plain field update.
  currentMatchId String?
  /// Short code typed into the /tv join screen instead of pasting the full
  /// URL — stable for the court's lifetime, unlike Match.umpireCode.
  tvCode         String   @unique
  createdAt      DateTime @default(now())

  @@index([tournamentId])
}

model Tournament {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  courts    Court[]
  matches   Match[]
  umpires   Umpire[]
  players   TournamentPlayer[]
}

/// A tournament's imported player roster — parsed from a CSV export
/// (MemberID, FirstName, LastName, Gender, Country, Club, BirthDate,
/// Category, Status) so admins pick a match's players from an autocomplete
/// instead of retyping names, and so match creation can validate a player
/// against their registered category, gender and age. See
/// packages/shared/src/players.ts for the parsing/validation logic, and
/// Player.tournamentPlayerId below for the link from a match's players.
model TournamentPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  /// The source system's id for this player, when the export has one.
  /// Nullable so a duplicate-import re-run can upsert by it; two rows with
  /// no memberId at all are just two separate manual entries.
  memberId     String?
  firstName    String
  lastName     String
  /// "M" | "F", or null — not every export includes it.
  gender       String?
  country      String?
  club         String?
  birthDate    DateTime?
  /// Raw slash-separated codes as imported, e.g. "MS/MD/XD".
  categories   String     @default("")
  /// Defaults to "Accepted" when the export doesn't specify one.
  status       String     @default("Accepted")
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, memberId])
  @@index([tournamentId])
}

model Umpire {
  id           String      @id @default(cuid())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  name         String
  createdAt    DateTime    @default(now())

  @@index([tournamentId])
}

model Match {
  id              String       @id @default(cuid())
  tournamentId    String?
  tournament      Tournament?  @relation(fields: [tournamentId], references: [id])
  /// "singles" | "doubles"
  matchType       String
  /// "CREATED" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  status          String       @default("CREATED")
  pointsToWin     Int
  capScore        Int
  intervalAt      Int
  /// Team/club name per side, as announced. Optional: club play often has
  /// none, while tournament play wants them on the TV wall.
  teamAName       String?
  teamBName       String?
  /// Country each side represents, optional even when a team name is set.
  teamACountry    String?
  teamBCountry    String?
  /// Competition category as announced, e.g. "BS U19", "WD U15". Free text:
  /// the codes vary by federation and age group, so a fixed list would be
  /// wrong somewhere. Optional — club play often has none.
  category        String?
  /// Locks matchType/scoring fields the moment the first point is scored.
  scoringLocked   Boolean      @default(false)
  /// Long random secret; required on every umpire write action.
  umpireToken     String       @unique
  /// Short code typed into the /umpire join screen; resolves to this match's
  /// id + umpireToken. Same one-time-reveal policy as umpireToken.
  umpireCode      String       @unique
  /// Last (or current) court this match was played on — for history,
  /// distinct from Court.currentMatchId which only reflects "right now".
  assignedCourtId String?
  /// The umpire officiating this match — occupies them the same way a court
  /// is occupied, so one person can't be double-booked onto two live matches.
  assignedUmpireId String?
  createdAt       DateTime     @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  players         Player[]
  events          ScoreEvent[]

  @@index([tournamentId])
}

model Player {
  id        String @id @default(cuid())
  matchId   String
  match     Match  @relation(fields: [matchId], references: [id])
  /// "A" | "B"
  side      String
  /// Given name. Players created before first/last name were captured
  /// separately hold their full name here — see formatPlayerName().
  name      String
  /// Family name. Defaults to empty so the column can be added to an existing
  /// database without touching the rows already in it.
  lastName  String @default("")
  shortName String
  /// The roster row this player was selected from, if any — see
  /// TournamentPlayer. Not a formal relation: a roster entry may be edited
  /// or removed later without touching history already recorded here, so
  /// this is traceability, not a source of truth for display.
  tournamentPlayerId String?

  @@index([matchId])
}

/// The append-only source of truth. Every derived value (score, set/match
/// winner, serve position, interval flags) comes from replaying these
/// through shared's deriveMatchState() — see packages/server/src/match/replay.ts.
model ScoreEvent {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  /// Client-generated idempotency key — replaying a queued offline action
  /// twice is safe because of this.
  eventId   String   @unique
  /// "START_SET" | "POINT" | "UNDO_LAST_POINT" | "RETIRE"
  type      String
  side      String?
  /// JSON-encoded extra fields for START_SET (firstServerPlayerId, courtPositions).
  payload   String?
  timestamp BigInt
  createdAt DateTime @default(now())

  @@index([matchId, timestamp])
}
